{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.5.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "mediumProvider": "openai-codex",
  "mediumModel": "gpt-6.1-sol",
  "smallProvider": "openai-codex",
  "smallModel": "gpt-6-luna",
  "theme": "catppuccin-macchiato",
  "editorPaddingX": 1,
  "defaultThinkingLevel": "xhigh",
  "defaultTools": [
    "+codemode"
  ],
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-6-luna"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-6-luna"
      },
      "worker": {
        "model": "openai-codex/gpt-6.1-sol"
      },
      "reviewer": {
        "model": "openai-codex/gpt-6.1-sol"
      },
      "delegate": {
        "model": "openai-codex/gpt-6.1-sol"
      },
      "researcher": {
        "model": "openai-codex/gpt-6.1-sol"
      },
      "evidence-auditor": {
        "model": "openai-codex/gpt-6-astra"
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra"
      }
    }
  },
  "hideThinkingBlock": false,
  "terminal": {
    "showImages": true,
    "clearOnShrink": false,
    "showTerminalProgress": false
  },
  "showHardwareCursor": true,
  "doubleEscapeAction": "tree",
  "extensions": [
    "-builtin:mcp"
  ],
  "packages": [
    "https://github.com/davebcn87/pi-autoresearch",
    "npm:pi-web-access",
    "npm:pi-subagents"
  ],
  "compaction": {
    "enabled": true
  },
  "quietStartup": true,
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "markdown": {
    "mermaid": "streaming"
  },
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "collapseChangelog": true,
  "extensionChangelogVersions": {
    "{\"source\":\"https://github.com/davebcn87/pi-autoresearch\",\"scope\":\"user\"}": "1.9.0",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.46.0",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.84.0"
  }
}