#!/bin/sh
set -eu

file=$1
line=${2:-}
set -- nvim -- "$file"
if [ -n "$line" ]; then set -- nvim "+$line" -- "$file"; fi

if [ -n "${PI_LAZYGIT_PARENT:-}" ] && [ -n "${REX_BLOCK:-}" ] && [ -n "${REX_SESSION:-}" ]; then
  # Split the Pi pane, not the floating layer containing lazygit. Keep the
  # popup available for the next toggle, but only hide it if the split worked.
  rex split -s "$REX_SESSION" -b "$PI_LAZYGIT_PARENT" --split=right --cwd "$PWD" -- "$@" >/dev/null
  exec rex api call -s "$REX_SESSION" session.detach_block "$(jq -nc --arg id "$REX_BLOCK" '{block_id: $id}')" >/dev/null
elif [ -n "${NVIM:-}" ] && nvim --server "$NVIM" --remote-expr '1' >/dev/null 2>&1; then
  nvim --server "$NVIM" --remote "$file"
  if [ -n "$line" ]; then nvim --server "$NVIM" --remote-send ":${line}<CR>"; fi
  exec nvim --server "$NVIM" --remote-send ':doautocmd User LazyGitEdit<CR>'
elif [ -n "${REX_SESSION:-}" ] && [ -n "${REX_BLOCK:-}" ] && command -v rex >/dev/null; then
  exec rex split -s "$REX_SESSION" -b "$REX_BLOCK" --split=right --cwd "$PWD" -- "$@"
else
  exec "$@"
fi
